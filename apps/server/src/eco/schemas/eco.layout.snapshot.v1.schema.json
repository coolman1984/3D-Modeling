{
  "$id": "https://eco.local/contracts/eco.layout.snapshot.v1.schema.json",
  "title": "eco.layout.snapshot.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "origin": {
      "type": "object",
      "properties": {
        "app": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "app",
        "type",
        "key"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "site": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "id",
        "code"
      ]
    },
    "length_unit": {
      "type": "string",
      "const": "0.1mm"
    },
    "items": {
      "maxItems": 20000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "x": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "y": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "rotation_mdeg": {
            "type": "integer",
            "minimum": 0,
            "maximum": 359999
          },
          "w": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "d": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "h": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "eco_ref": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "plant_node",
                  "warehouse",
                  "storage_location"
                ]
              },
              "id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            },
            "required": [
              "type",
              "id",
              "code"
            ]
          }
        },
        "required": [
          "item_id",
          "name",
          "category",
          "x",
          "y",
          "rotation_mdeg",
          "w",
          "d",
          "h"
        ]
      }
    },
    "zones": {
      "maxItems": 2000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "polygon": {
            "minItems": 3,
            "maxItems": 500,
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          },
          "eco_ref": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "plant_node",
                  "warehouse",
                  "storage_location"
                ]
              },
              "id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            },
            "required": [
              "type",
              "id",
              "code"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "polygon"
        ]
      }
    }
  },
  "required": [
    "id",
    "code",
    "version",
    "origin",
    "name",
    "revision",
    "length_unit",
    "items",
    "zones"
  ]
}
